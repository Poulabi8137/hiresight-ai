# Required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for DB write operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for AI features (at least one)
GOOGLE_AI_API_KEY=
# or:
GOOGLE_GENERATIVE_AI_API_KEY=

# Required for AI-powered scoring
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — Demo mode (bypasses Supabase auth for local dev)
HIRESIGHT_DEMO_AUTH=true

# Optional — Monitoring with Sentry
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional — Upstash Redis for rate limiting + caching
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — Bundle analysis (npm run analyze)
# ANALYZE=true

# Optional — Docker compose env file reference
# Copy this file to .env.production for docker compose usage
